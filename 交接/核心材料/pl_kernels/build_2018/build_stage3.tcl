# =====================================================================
# Stage 3: control reset + audio internal wiring + external ports.
# =====================================================================
open_project D:/g_build/proj/voice7020.xpr
open_bd_design [get_files zynq.bd]

# ---- control-plane reset (active-low, 100M) ----
set crst [create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 ctrl_rst]
connect_bd_net [get_bd_pins ps7/FCLK_CLK0]      [get_bd_pins ctrl_rst/slowest_sync_clk]
connect_bd_net [get_bd_pins ps7/FCLK_RESET0_N]  [get_bd_pins ctrl_rst/ext_reset_in]

# =====================================================================
# AUDIO DATA FLOW (interfaces)
# =====================================================================
# capture: i2s_receiver -> formatter s2mm
connect_bd_intf_net [get_bd_intf_pins i2s_receiver/m_axis_aud] [get_bd_intf_pins audio_formatter/s_axis_s2mm]
# playback: formatter mm2s -> i2s_transmitter
connect_bd_intf_net [get_bd_intf_pins audio_formatter/m_axis_mm2s] [get_bd_intf_pins i2s_transmitter/s_axis_aud]
# formatter DMA engines -> audio dma interconnect
connect_bd_intf_net [get_bd_intf_pins audio_formatter/m_axi_mm2s] [get_bd_intf_pins audio_dma_ic/S00_AXI]
connect_bd_intf_net [get_bd_intf_pins audio_formatter/m_axi_s2mm] [get_bd_intf_pins audio_dma_ic/S01_AXI]
# audio dma interconnect -> HP0
connect_bd_intf_net [get_bd_intf_pins audio_dma_ic/M00_AXI] [get_bd_intf_pins ps7/S_AXI_HP0]

# =====================================================================
# AUDIO CLOCKS (scalar)
# =====================================================================
# control clocks (100M)
connect_bd_net [get_bd_pins ps7/FCLK_CLK0] \
  [get_bd_pins audio_formatter/s_axi_lite_aclk] \
  [get_bd_pins audio_formatter/m_axis_mm2s_aclk] \
  [get_bd_pins audio_formatter/s_axis_s2mm_aclk] \
  [get_bd_pins i2s_receiver/s_axi_ctrl_aclk] \
  [get_bd_pins i2s_receiver/m_axis_aud_aclk] \
  [get_bd_pins i2s_transmitter/s_axi_ctrl_aclk] \
  [get_bd_pins i2s_transmitter/s_axis_aud_aclk] \
  [get_bd_pins audio_dynclk/REF_CLK_I] \
  [get_bd_pins audio_dynclk/s_axi_lite_aclk] \
  [get_bd_pins audio_dma_ic/ACLK] \
  [get_bd_pins audio_dma_ic/S00_ACLK] \
  [get_bd_pins audio_dma_ic/S01_ACLK] \
  [get_bd_pins audio_dma_ic/M00_ACLK]

# audio MCLK (generated by dynclk)
connect_bd_net [get_bd_pins audio_dynclk/PXL_CLK_O] \
  [get_bd_pins audio_formatter/aud_mclk] \
  [get_bd_pins i2s_receiver/aud_mclk] \
  [get_bd_pins i2s_transmitter/aud_mclk]

# =====================================================================
# AUDIO RESETS
# =====================================================================
# audio reset (clocked by MCLK, locked by dynclk), active-high aud_mreset
connect_bd_net [get_bd_pins audio_dynclk/PXL_CLK_O]   [get_bd_pins audio_rst/slowest_sync_clk]
connect_bd_net [get_bd_pins audio_dynclk/LOCKED_O] \
  [get_bd_pins audio_rst/ext_reset_in] [get_bd_pins audio_rst/dcm_locked]
connect_bd_net [get_bd_pins audio_rst/peripheral_reset] \
  [get_bd_pins audio_formatter/aud_mreset] \
  [get_bd_pins i2s_receiver/aud_mrst] \
  [get_bd_pins i2s_transmitter/aud_mrst]

# control active-low resets
connect_bd_net [get_bd_pins ctrl_rst/peripheral_aresetn] \
  [get_bd_pins audio_formatter/s_axi_lite_aresetn] \
  [get_bd_pins audio_formatter/m_axis_mm2s_aresetn] \
  [get_bd_pins audio_formatter/s_axis_s2mm_aresetn] \
  [get_bd_pins i2s_receiver/s_axi_ctrl_aresetn] \
  [get_bd_pins i2s_receiver/m_axis_aud_aresetn] \
  [get_bd_pins i2s_transmitter/s_axi_ctrl_aresetn] \
  [get_bd_pins i2s_transmitter/s_axis_aud_aresetn] \
  [get_bd_pins audio_dynclk/s_axi_lite_aresetn] \
  [get_bd_pins audio_dma_ic/S00_ARESETN] \
  [get_bd_pins audio_dma_ic/S01_ARESETN] \
  [get_bd_pins audio_dma_ic/M00_ARESETN]

# =====================================================================
# I2S SIGNALS + EXTERNAL PORTS
# =====================================================================
create_bd_port -dir O MCLK
connect_bd_net [get_bd_pins audio_dynclk/PXL_CLK_O] [get_bd_ports MCLK]

create_bd_port -dir O ADCLRC
connect_bd_net [get_bd_pins i2s_receiver/lrclk_out] [get_bd_ports ADCLRC]

create_bd_port -dir O DACLRC
connect_bd_net [get_bd_pins i2s_transmitter/lrclk_out] [get_bd_ports DACLRC]

create_bd_port -dir O BCLK
connect_bd_net [get_bd_pins i2s_receiver/sclk_out] [get_bd_pins bclk_or/Op1]
connect_bd_net [get_bd_pins i2s_transmitter/sclk_out] [get_bd_pins bclk_or/Op2]
connect_bd_net [get_bd_pins bclk_or/Res] [get_bd_ports BCLK]

create_bd_port -dir O DACDAT
connect_bd_net [get_bd_pins i2s_transmitter/sdata_0_out] [get_bd_ports DACDAT]

create_bd_port -dir I ADCDAT
connect_bd_net [get_bd_ports ADCDAT] [get_bd_pins i2s_receiver/sdata_0_in]

# PS AXI ACLKs (GP0/HP0-3) on FCLK_CLK0
connect_bd_net [get_bd_pins ps7/FCLK_CLK0] \
  [get_bd_pins ps7/M_AXI_GP0_ACLK] [get_bd_pins ps7/S_AXI_HP0_ACLK] \
  [get_bd_pins ps7/S_AXI_HP1_ACLK] [get_bd_pins ps7/S_AXI_HP2_ACLK] [get_bd_pins ps7/S_AXI_HP3_ACLK]

save_bd_design
validate_bd_design
puts STAGE3_DONE
exit
